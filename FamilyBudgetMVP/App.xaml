<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FamilyBudgetMVP"
             xmlns:converters="clr-namespace:FamilyBudgetMVP.Converters"
             x:Class="FamilyBudgetMVP.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Конвертеры уровня приложения: доступны всем страницам -->
            <converters:AmountColorConverter x:Key="AmountColorConverter" />
            <converters:CategoryIconConverter x:Key="CategoryIcon" />
            <converters:CategoryTintConverter x:Key="CategoryTint" />
            <converters:CategoryColorConverter x:Key="CategoryColor" />
            <converters:HexToColorConverter x:Key="HexToColor" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
