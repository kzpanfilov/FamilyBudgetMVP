<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:FamilyBudgetMVP.Converters"
             x:Class="FamilyBudgetMVP.MainPage"
             Title="Мой бюджет">

    <ContentPage.Resources>
        <converters:AmountColorConverter x:Key="AmountColorConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        
        <!-- Заголовок с балансом -->
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="5">
            <Label Text="Текущий баланс" FontSize="18" TextColor="Gray" />
            <Label x:Name="BalanceLabel" Text="0.00 ₽" FontSize="32" FontAttributes="Bold" TextColor="#2E7D32" />
        </VerticalStackLayout>

        <!-- Список транзакций -->
        <CollectionView Grid.Row="1" x:Name="TransactionsList"
                        ItemsSource="{Binding Transactions}" 
                        EmptyView="Транзакций пока нет">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="10,5" CornerRadius="10" HasShadow="True">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Description}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Category}" TextColor="Gray" FontSize="14" />
                                <Label Text="{Binding DateShort}" TextColor="LightGray" FontSize="12" />
                            </VerticalStackLayout>
                            
                            <Label Grid.Column="1" 
                                   Text="{Binding FormattedAmount}" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="{Binding Amount, Converter={StaticResource AmountColorConverter}, Mode=OneWay}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>