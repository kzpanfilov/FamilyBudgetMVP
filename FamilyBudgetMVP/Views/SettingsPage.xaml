<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FamilyBudgetMVP.Views.SettingsPage"
             Title="Настройки">

    <ScrollView Padding="20,8">
        <VerticalStackLayout Spacing="14"
                             HorizontalOptions="Center"
                             WidthRequest="{OnIdiom Desktop=560, Tablet=560, Phone=-1}">

            <VerticalStackLayout Spacing="10" Margin="0,4,0,0">

                <!-- Премиум -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <HorizontalStackLayout Spacing="8">
                            <Rectangle WidthRequest="4" HeightRequest="18" RadiusX="2" RadiusY="2" Fill="{StaticResource Teal500}"/>
                            <Label Text="Премиум" Style="{StaticResource SectionTitle}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label x:Name="PremiumStatusLabel" FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"/>

                        <Label x:Name="PremiumHintLabel" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>

                        <Border Style="{StaticResource InputWrap}">
                            <Entry x:Name="PremiumCodeEntry"
                                   Placeholder="BP-XXXXX-XXXXX-XXXXX-XXXXX"/>
                        </Border>

                        <Button x:Name="ActivatePremiumButton"
                                Text="Активировать премиум"
                                Style="{StaticResource PrimaryButton}"
                                Clicked="OnActivatePremiumClicked"/>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="8">
                    <Rectangle WidthRequest="4" HeightRequest="18" RadiusX="2" RadiusY="2" Fill="{StaticResource Teal500}" VerticalOptions="Center"/>
                    <Label Text="Категории" Style="{StaticResource SectionTitle}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Text="Категории используются в форме операции и на графике расходов."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>
            </VerticalStackLayout>

                <!-- Список категорий -->
                <Border Style="{StaticResource Card}" Padding="6">
                    <CollectionView x:Name="CategoriesList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" Padding="12,7">
                                    <Grid.GestureRecognizers>
                                        <!-- клик по строке — редактирование месячного лимита -->
                                        <TapGestureRecognizer Tapped="OnCategoryTapped"/>
                                    </Grid.GestureRecognizers>

                                    <Border Grid.Column="0"
                                            WidthRequest="40" HeightRequest="40"
                                            StrokeThickness="0"
                                            StrokeShape="Ellipse"
                                            BackgroundColor="{Binding TintHex, Converter={StaticResource HexToColor}}">
                                        <Label Text="{Binding Icon}" FontSize="18"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <BoxView Grid.Column="1"
                                             WidthRequest="10" HeightRequest="10"
                                             CornerRadius="5"
                                             VerticalOptions="Center"
                                             Color="{Binding ColorHex, Converter={StaticResource HexToColor}}"/>

                                    <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontFamily="OpenSansSemibold" FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"/>
                                        <Label Text="{Binding LimitText}" FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="3" Text="✕"
                                            Style="{StaticResource GhostDelete}"
                                            Clicked="OnDeleteCategoryClicked"
                                            VerticalOptions="Center"/>

                                    <BoxView Grid.ColumnSpan="4" HeightRequest="1" VerticalOptions="End"
                                             Color="{AppThemeBinding Light={StaticResource SurfaceBorder}, Dark={StaticResource SurfaceBorderDark}}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <!-- Новая категория -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <HorizontalStackLayout Spacing="8">
                            <Rectangle WidthRequest="4" HeightRequest="18" RadiusX="2" RadiusY="2" Fill="{StaticResource Teal500}"/>
                            <Label Text="Новая категория" Style="{StaticResource SectionTitle}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Border Style="{StaticResource InputWrap}">
                            <Entry x:Name="NameEntry"
                                   Placeholder="Название, например: Обучение"
                                   ReturnType="Done"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>
                        </Border>

                        <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource InputWrap}">
                                <Entry x:Name="IconEntry"
                                       Placeholder="📦"
                                       MaxLength="4"
                                       HorizontalTextAlignment="Center"
                                       FontSize="18"/>
                            </Border>
                            <FlexLayout Grid.Column="1" x:Name="SwatchPanel" Wrap="Wrap" JustifyContent="Start" AlignItems="Start"/>
                        </Grid>

                        <Button Text="＋  Добавить категорию"
                                Style="{StaticResource PrimaryButton}"
                                Clicked="OnAddCategoryClicked"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Данные: экспорт -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <HorizontalStackLayout Spacing="8">
                            <Rectangle WidthRequest="4" HeightRequest="18" RadiusX="2" RadiusY="2" Fill="{StaticResource Teal500}"/>
                            <Label Text="Данные" Style="{StaticResource SectionTitle}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label Text="Выгрузка всех операций в CSV (Excel): дата, тип, категория, сумма, описание."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>

                        <Button Text="⬇  Выгрузить операции в CSV"
                                Style="{StaticResource PrimaryButton}"
                                Clicked="OnExportClicked"/>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource SurfaceBorder}, Dark={StaticResource SurfaceBorderDark}}"/>

                        <Label Text="Резервная копия базы данных. Сохраните файл .db для переноса на другое устройство."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="💾  Бэкап"
                                    Style="{StaticResource PrimaryButton}"
                                    Clicked="OnBackupClicked"/>
                            <Button Grid.Column="1" Text="📂  Восстановить"
                                    Style="{StaticResource PrimaryButton}"
                                    Clicked="OnRestoreClicked"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Безопасность: PIN -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <HorizontalStackLayout Spacing="8">
                            <Rectangle WidthRequest="4" HeightRequest="18" RadiusX="2" RadiusY="2" Fill="{StaticResource Teal500}"/>
                            <Label Text="Безопасность" Style="{StaticResource SectionTitle}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label Text="Блокировка приложения PIN-кодом при каждом запуске."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="Блокировка PIN-кодом"
                                   FontSize="15" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource InkPrimary}, Dark={StaticResource InkPrimaryDark}}"/>
                            <Switch x:Name="LockSwitch" Grid.Column="1"
                                    Toggled="OnLockToggled"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <Button x:Name="ChangePinButton"
                                Text="Сменить PIN-код"
                                Style="{StaticResource PrimaryButton}"
                                IsVisible="False"
                                Clicked="OnChangePinClicked"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Семья: совместный бюджет -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">

                        <HorizontalStackLayout Spacing="8">
                            <Rectangle WidthRequest="4" HeightRequest="18" RadiusX="2" RadiusY="2" Fill="{StaticResource Teal500}"/>
                            <Label Text="Семья" Style="{StaticResource SectionTitle}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label Text="Экспорт/импорт операций для совместного бюджета. Отправьте JSON-файл члену семьи через мессенджер."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="📤  Поделиться"
                                    Style="{StaticResource PrimaryButton}"
                                    Clicked="OnShareFamilyClicked"/>
                            <Button Grid.Column="1" Text="📥  Импорт"
                                    Style="{StaticResource PrimaryButton}"
                                    Clicked="OnImportFamilyClicked"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
</ContentPage>
