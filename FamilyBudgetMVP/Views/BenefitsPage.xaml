<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FamilyBudgetMVP.Views.BenefitsPage"
             Title="Льготы">

    <Grid RowDefinitions="Auto,*">
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ContentHost"
                                 Padding="20,8"
                                 Spacing="12"
                                 HorizontalOptions="Center"
                                 WidthRequest="{OnIdiom Desktop=640, Tablet=640, Phone=-1}">

                <!-- Поиск -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Rectangle WidthRequest="4" HeightRequest="18" RadiusX="2" RadiusY="2"
                                       Fill="{StaticResource Teal500}" VerticalOptions="Center"/>
                            <Label Text="Льготы и субсидии" Style="{StaticResource SectionTitle}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Border Style="{StaticResource InputWrap}">
                            <Entry x:Name="SearchEntry"
                                   Placeholder="Поиск: многодетные, ипотека, ЖКХ…"
                                   TextChanged="OnSearchChanged"/>
                        </Border>

                        <Border Style="{StaticResource InputWrap}">
                            <Picker x:Name="RegionPicker" SelectedIndexChanged="OnRegionChanged">
                                <Picker.Items>
                                    <x:String>Все регионы</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label x:Name="ActualLabel" Grid.Column="0" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"
                                   VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="⟳ Обновить"
                                    Style="{StaticResource QuickChip}"
                                    Clicked="OnRefreshCatalogClicked"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Результаты -->
                <Label x:Name="ResultsCountLabel" FontSize="13" IsVisible="False"
                       TextColor="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"/>

                <VerticalStackLayout x:Name="ResultsList" Spacing="10"/>

                <!-- Шаблоны документов -->
                <HorizontalStackLayout Spacing="8" Margin="0,10,0,0">
                    <Rectangle WidthRequest="4" HeightRequest="18" RadiusX="2" RadiusY="2"
                               Fill="{StaticResource Teal500}" VerticalOptions="Center"/>
                    <Label Text="Шаблоны документов" Style="{StaticResource SectionTitle}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <VerticalStackLayout x:Name="TemplatesList" Spacing="8"/>

                <!-- Пустое состояние -->
                <VerticalStackLayout x:Name="EmptyState" IsVisible="False" Padding="0,24" Spacing="4">
                    <Label Text="🔍" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="Ничего не найдено" FontFamily="OpenSansSemibold" HorizontalOptions="Center"/>
                    <Label Text="Измените регион или поисковый запрос" FontSize="13" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Премиум-замок: перекрывает контент, пока премиум не активирован -->
        <VerticalStackLayout x:Name="PremiumLock"
                             Grid.RowSpan="2"
                             IsVisible="False"
                             Spacing="12"
                             Padding="24"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Bg}, Dark={StaticResource BgDark}}">
            <Border WidthRequest="96" HeightRequest="96"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=#FFF7E6, Dark=#2B2419}"
                    HorizontalOptions="Center">
                <Label Text="🔒" FontSize="44" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Text="Полный справочник — премиум"
                   FontFamily="OpenSansSemibold" FontSize="17"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"/>
            <Label Text="Активируйте премиум в Настройках, чтобы открыть все льготы и шаблоны документов."
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   MaxLines="3"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>
            <Button Text="⭐  Открыть премиум"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnPremiumClicked"
                    HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
